# Login required: used when BASIC_AUTH_USER and a password are set as Railway variables (never in git).
# start.sh turns BASIC_AUTH_PASSWORD into the bcrypt BASIC_AUTH_HASH used below.
{
	admin off
	auto_https off
	persist_config off
}

import /etc/caddy/site.caddy

:{$PORT:8080} {
	# Railway's health check must reach this without the login.
	handle /healthz {
		respond "ok" 200
	}
	handle {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		import site
	}
}
